plugins {
    id 'nf-azure@1.22.5'
    id 'nf-ga4gh@1.5.0'
}

def azureAccountName = System.getenv('AZURE_ACCOUNT_NAME') ?: '<your-storage-account-name>'
def azureSasToken = System.getenv('AZURE_STORAGE_SAS_TOKEN') ?: '<your-sas-token>'
def tesEndpoint = System.getenv('TES_ENDPOINT') ?: 'http://localhost:8000/ga4gh/tes'
def tesUsername = System.getenv('TES_USERNAME') ?: '<your-tes-username>'
def tesPassword = System.getenv('TES_PASSWORD') ?: '<your-tes-password>'

process {
  executor = 'tes'
  container = 'quay.io/nextflow/bash'
  cpus = 1
  memory = '2 GB'
  // Retry once on timeout/connection errors before failing
  errorStrategy = { task.exitStatus in [null] ? 'retry' : 'finish' }
  maxRetries = 1
}

azure {

  storage {
    accountName = azureAccountName
    sasToken = azureSasToken
  }
}

tes {
    // See `Authentication` section
    endpoint = tesEndpoint

    basicUsername = tesUsername
    basicPassword = tesPassword

    // Increase timeout for slow task status polls (default is 10s)
    httpConnectTimeout = '60s'
    httpReadTimeout = '60s'
}
